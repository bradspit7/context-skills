# Python bytecode (regenerated by py_compile / running tests; never committed).
__pycache__/
*.pyc

# Browser-tool output. The Playwright MCP writes screenshots, console logs and page
# snapshots to .playwright-mcp/ in whatever directory it happens to be rooted at -
# which is routinely a repo root. Console logs and page snapshots capture rendered
# page content, so this is a content-exposure guard, not just tidiness.
.playwright-mcp/
